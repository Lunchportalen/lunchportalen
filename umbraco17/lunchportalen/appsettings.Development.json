{
  "$schema": "appsettings-schema.json",
  // Lokal DB-passord: opprett appsettings.Development.local.json (gitignored) med ConnectionStrings.
  "ConnectionStrings": {
    "umbracoDbDSN": "Server=tcp:lunchportalen-sql.database.windows.net,1433;Initial Catalog=lunchportalen-db-v2;Persist Security Info=False;User ID=Lunchportalen;Password=;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "Storage": {
      "AzureBlob": {
        "Media": {
          "ConnectionString": "UseDevelopmentStorage=true"
        }
      }
    },
    "CMS": {
      "ModelsBuilder": {
        "ModelsMode": "SourceCodeManual"
      },
      "Content": {
        "MacroErrors": "Throw"
      },
      "Hosting": {
        "Debug": true
      }
    }
  }
}
