@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Web.Common
@inject UmbracoHelper UmbracoHelper

@{
    var siteSettings = UmbracoHelper.ContentAtRoot()
        .FirstOrDefault(x => x.ContentType.Alias == "siteSettings");

    var faviconUrl = siteSettings?.Value<MediaWithCrops>("favIcon")?.MediaUrl()
        ?? siteSettings?.Value<IPublishedContent>("favIcon")?.Url()
        ?? "/media/zkhfkr4f/favicon-16x16.png";

    var pageTitle = Model?.Value<string>("pageTitle");
    var seoDescription = Model?.Value<string>("seoDescription");
    var ogImageItem = Model?.Value<IPublishedContent>("ogImage");
    var ogImage = ogImageItem?.Url();

    if (string.IsNullOrWhiteSpace(pageTitle))
    {
        pageTitle = Model?.Name ?? "Lunchportalen";
    }

    if (string.IsNullOrWhiteSpace(seoDescription))
    {
        seoDescription = "Lunchportalen gjør firmalunsj enklere å bestille, administrere og levere.";
    }

    if (string.IsNullOrWhiteSpace(ogImage))
    {
        ogImage = faviconUrl;
    }

    if (!string.IsNullOrWhiteSpace(ogImage) && ogImage.StartsWith("/"))
    {
        ogImage = "https://www.lunchportalen.no" + ogImage;
    }

    var path = ViewContext.HttpContext.Request.Path.ToString().TrimEnd('/');
    var canonicalUrl = "https://www.lunchportalen.no" + path;

    if (canonicalUrl == "https://www.lunchportalen.no")
    {
        canonicalUrl += "/";
    }
}

<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@pageTitle</title>
    <meta name="description" content="@seoDescription" />
    <meta name="robots" content="index,follow" />

    <link rel="canonical" href="@canonicalUrl" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@seoDescription" />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Lunchportalen" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@seoDescription" />
    <meta name="twitter:image" content="@ogImage" />

    <link rel="stylesheet" href="/css/design-system.css" />
    <link rel="stylesheet" href="/css/header.css" />
    <link rel="stylesheet" href="/css/hero.css" />
    <link rel="stylesheet" href="/css/landing-page-blocks.css" />
    <link rel="stylesheet" href="/css/footer.css" />
    <link rel="stylesheet" href="/css/contact.css" />
    <link rel="stylesheet" href="/css/benefits.css" />
    <link rel="stylesheet" href="/css/demo-page-blocks.css" />
    <link rel="stylesheet" href="/priser-page-blocks.css" />
    <link rel="stylesheet" href="/css/fordeler.css">
    <link rel="stylesheet" href="/css/kom-i-gang.css" />

    @await RenderSectionAsync("Head", required: false)

    <link rel="icon" type="image/png" href="@faviconUrl" />
    <link rel="apple-touch-icon" href="@faviconUrl" />
</head>

<body>

    @await Html.PartialAsync("~/Views/Partials/_Header.cshtml")

    <main class="ds-page">
        @RenderBody()
    </main>

    @await Html.PartialAsync("~/Views/Partials/_Footer.cshtml")

    <script>
        (function () {
            var header = document.querySelector('.lp-header');

            if (header) {
                document.body.style.setProperty('--lp-nav-h', header.offsetHeight + 'px');

                var updateHeader = function () {
                    if (window.scrollY > 20) {
                        header.classList.add('scrolled');
                    } else {
                        header.classList.remove('scrolled');
                    }
                };

                updateHeader();
                window.addEventListener('scroll', updateHeader, { passive: true });
            }

            var fadeItems = document.querySelectorAll('.ds-fade-up');
            var howItems = document.querySelectorAll('#howitworks .ds-how-row');

            if (fadeItems.length || howItems.length) {
                if (!('IntersectionObserver' in window)) {
                    fadeItems.forEach(function (item) { item.classList.add('is-visible'); });
                    howItems.forEach(function (item) { item.classList.add('is-visible'); });
                } else {
                    var observer = new IntersectionObserver(function (entries, obs) {
                        entries.forEach(function (entry) {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('is-visible');
                                obs.unobserve(entry.target);
                            }
                        });
                    }, {
                        threshold: 0.14,
                        rootMargin: '0px 0px -40px 0px'
                    });

                    fadeItems.forEach(function (item) { observer.observe(item); });
                    howItems.forEach(function (item) { observer.observe(item); });
                }
            }

            var toggle = document.querySelector('.lp-hamburger');
            var menu = document.querySelector('.lp-mobile-menu');

            if (toggle && header && menu) {
                function closeMenu() {
                    toggle.setAttribute('aria-expanded', 'false');
                    toggle.setAttribute('aria-label', 'Åpne meny');
                    header.classList.remove('is-menu-open');
                    menu.setAttribute('aria-hidden', 'true');
                    document.body.classList.remove('lp-menu-open');
                }

                function openMenu() {
                    toggle.setAttribute('aria-expanded', 'true');
                    toggle.setAttribute('aria-label', 'Lukk meny');
                    header.classList.add('is-menu-open');
                    menu.setAttribute('aria-hidden', 'false');
                    document.body.classList.add('lp-menu-open');
                }

                toggle.addEventListener('click', function () {
                    var isOpen = toggle.getAttribute('aria-expanded') === 'true';
                    isOpen ? closeMenu() : openMenu();
                });

                menu.querySelectorAll('a').forEach(function (link) {
                    link.addEventListener('click', closeMenu);
                });

                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') {
                        closeMenu();
                    }
                });

                document.addEventListener('click', function (e) {
                    if (!header.contains(e.target)) {
                        closeMenu();
                    }
                });
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
