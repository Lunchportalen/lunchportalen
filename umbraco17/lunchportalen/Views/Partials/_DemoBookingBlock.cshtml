@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement?>
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models.Blocks

@{
    var eyebrow = Model?.Value<string>("eyebrow") ?? "Book demo eller send interesse";
    var heading = Model?.Value<string>("heading") ?? "Vil du se hvordan plattformen fungerer for dere?";
    var text    = Model?.Value<string>("text")
        ?? "Book en uforpliktende demo — eller send interesse som bedrift. Vi tar kontakt og kobler dere videre når det passer.";
    var btnText = Model?.Value<string>("buttonText") ?? "Book demo / send interesse";

    var checkBlocks   = Model?.Value<BlockListModel>("checks");
    var defaultChecks = new[] { "15 minutter", "Ingen forpliktelser", "For bedrifter og caterere" };
    bool hasChecks    = checkBlocks != null && checkBlocks.Any();
}

<section class="lp-demo-booking" id="book-demo">
    <div class="lp-demo-inner lp-demo-booking-grid">

        <div class="lp-reveal">
            <p class="lp-demo-eyebrow">@eyebrow</p>
            <h2>@heading</h2>
            <p class="lp-demo-lead">@text</p>

            <ul class="lp-demo-checks" aria-label="Hva du får">
                @if (hasChecks)
                {
                    foreach (var block in checkBlocks!)
                    {
                        var checkText = block.Content.Value<string>("text") ?? "";
                        if (!string.IsNullOrWhiteSpace(checkText))
                        {
                            <li>@checkText</li>
                        }
                    }
                }
                else
                {
                    foreach (var check in defaultChecks)
                    {
                        <li>@check</li>
                    }
                }
            </ul>
        </div>

        <div class="lp-demo-booking-cta lp-reveal lp-reveal--delay-100">
            <a href="@AppUrls.Demo("forside-interesse")"
               class="lp-demo-booking-cta__btn"
               aria-label="@btnText – åpner demo-skjema i Lunchportalen-appen">
                @btnText
            </a>
            <p class="lp-demo-booking-cta__note">
                Vi tar kontakt innen én virkedag. Ingen forpliktelser.
            </p>
        </div>
    </div>
</section>
