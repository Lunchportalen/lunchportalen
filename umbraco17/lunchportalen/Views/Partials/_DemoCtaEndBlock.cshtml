@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement>
@using Umbraco.Extensions

@{
    var eyebrow      = Model.Value<string>("eyebrow")      ?? "Klar for neste steg?";
    var heading      = Model.Value<string>("heading")      ?? "Fjern kaoset rundt firmalunsj";
    var text         = Model.Value<string>("text")         ?? "Dropp manuelle bestillinger, usikker produksjon og unødvendig matsvinn. Lunchportalen gir en strukturert og forutsigbar løsning for hele bedriften – uten daglig oppfølging.";
    var ctaLabel     = Model.Value<string>("ctaLabel")     ?? "Book demo";
    var ctaUrl       = AppUrls.ResolveLeadCapture("demo-cta-end");
    var secLabel     = Model.Value<string>("secLabel")     ?? "Logg inn";
    var secUrl       = AppUrls.ResolveLogin(Model.Value<string>("secUrl"));
    var trustSignal  = Model.Value<string>("trustSignal")  ?? "15 minutter · Ingen forpliktelser · Passer bedrifter med 20+ ansatte";

    bool hasSecCta = !string.IsNullOrWhiteSpace(secLabel);
}

<section class="lp-demo-final">
    <div class="lp-demo-inner">
        <div class="lp-demo-final-card lp-reveal">

            <p class="lp-demo-eyebrow lp-demo-eyebrow--light">@eyebrow</p>
            <h2>@heading</h2>
            <p>@text</p>

            <div class="lp-demo-final-card__actions">
                <a href="@ctaUrl"
                   class="lp-demo-final-card__cta"
                   aria-label="@ctaLabel – åpner demo-skjema i Lunchportalen-appen">
                    @ctaLabel
                </a>

                @if (hasSecCta)
                {
                    <a href="@secUrl"
                       class="lp-demo-final-card__sec"
                       aria-label="@secLabel">
                        @secLabel
                    </a>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(trustSignal))
            {
                <p class="lp-demo-final-card__trust" aria-label="Hva demoen innebærer">@trustSignal</p>
            }

        </div>
    </div>
</section>
