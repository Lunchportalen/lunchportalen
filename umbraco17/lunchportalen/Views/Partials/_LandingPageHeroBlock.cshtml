@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement?>
@using System.Linq
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Models.Blocks

@{
    var content           = Model;
    var eyebrow           = content?.Value<string>("eyebrow")        ?? "Driftsplattform for firmalunsj i Norge";
    var heading           = content?.Value<string>("heading")        ?? "Finn firmalunsj";
    var headingOutline    = content?.Value<string>("headingOutline") ?? "via caterer";
    var headingGold       = content?.Value<string>("headingGold")    ?? "nær dere.";
    var leadText          = content?.Value<string>("leadText")
        ?? "Ansatte bestiller selv innen kl. 08:00. Plattformen kobler bedriften med caterere i ditt område — dere betaler kun for det som faktisk spises.";
    var primaryCtaText    = content?.Value<string>("primaryCtaText")  ?? "Book demo som bedrift";
    var primaryCtaLinks   = content?.Value<IEnumerable<Link>>("primaryCtaLink");
    var primaryCta        = primaryCtaLinks?.FirstOrDefault();
    var secondaryCtaText  = content?.Value<string>("secondaryCtaText") ?? "For caterere";
    var secondaryCtaLinks = content?.Value<IEnumerable<Link>>("secondaryCtaLink");
    var secondaryCta      = secondaryCtaLinks?.FirstOrDefault();
    var heroImage         = content?.Value<IPublishedContent>("heroImage");
    var heroImageUrl      = heroImage?.Url() ?? "";
    var visualBackground  = content?.Value<IPublishedContent>("backgroundImage");
    var visualBackgroundUrl = visualBackground?.Url() ?? "";
    var primaryUrl        = AppUrls.Demo("forside-kunde");
    var secondaryUrl      = AppUrls.Demo("forside-caterer");
    if (secondaryCta != null && !string.IsNullOrWhiteSpace(secondaryCta.Url))
    {
        secondaryUrl = AppUrls.ResolveGenericHeroSecondary(secondaryCta.Url, "forside-caterer", "#howitworks-caterer");
    }
    var stats             = content?.Value<IEnumerable<BlockListItem>>("stats");
    var logos             = content?.Value<IEnumerable<string>>("logos");
    if (logos == null || !logos.Any())
    {
        logos = new[] { "Bedrifter i hele Norge", "Caterere på plattformen", "Drift i sanntid" };
    }
}

<section class="lp-lp-hero">
  @if (!string.IsNullOrWhiteSpace(visualBackgroundUrl))
  {
    <div class="lp-lp-hero__background" aria-hidden="true">
      <img src="@visualBackgroundUrl" alt="" role="presentation" loading="eager" fetchpriority="high" />
    </div>
  }

  <div class="lp-lp-deco-circle lp-lp-deco-circle--tr" aria-hidden="true"></div>
  <div class="lp-lp-deco-circle lp-lp-deco-circle--bl" aria-hidden="true"></div>

  <div class="lp-lp-hero__inner">

    <div class="lp-lp-hero__left">

      <div class="lp-lp-tag">
        <span class="lp-lp-tag__dot"></span>
        <span class="lp-lp-tag__text">@eyebrow</span>
      </div>

      <h1 class="lp-lp-hero__title">
        @if (!string.IsNullOrWhiteSpace(heading))
        {
          @Html.Raw(heading)<br/>
        }
        @if (!string.IsNullOrWhiteSpace(headingOutline))
        {
          <span class="lp-lp-hero__title-outline">@headingOutline</span>
        }
        @if (!string.IsNullOrWhiteSpace(headingGold))
        {
          <span class="lp-lp-hero__title-gold">@headingGold</span>
        }
      </h1>

      @if (!string.IsNullOrWhiteSpace(leadText))
      {
        <p class="lp-lp-hero__lead">@leadText</p>
      }

      <div class="lp-lp-hero__cta-row">
        <a href="@primaryUrl"
           class="lp-lp-btn-primary"
           @(primaryCta?.Target == "_blank" ? Html.Raw("target=\"_blank\" rel=\"noopener\"") : Html.Raw(""))>
          @primaryCtaText
          <span class="lp-lp-btn-arrow" aria-hidden="true">→</span>
        </a>
        <a href="@secondaryUrl"
           class="lp-lp-btn-ghost"
           @(secondaryCta?.Target == "_blank" ? Html.Raw("target=\"_blank\" rel=\"noopener\"") : Html.Raw(""))>
          <span class="lp-lp-play-icon" aria-hidden="true">▶</span>
          @secondaryCtaText
        </a>
      </div>

      @if (stats != null && stats.Any())
      {
        <div class="lp-lp-stats">
          @foreach (var stat in stats)
          {
            var val = stat.Content.Value<string>("value");
            var lbl = stat.Content.Value<string>("label");
            if (string.IsNullOrWhiteSpace(val) && string.IsNullOrWhiteSpace(lbl)) { continue; }
            <div class="lp-lp-stat">
              <div class="lp-lp-stat__val">@val</div>
              <div class="lp-lp-stat__lbl">@lbl</div>
            </div>
          }
        </div>
      }

    </div>

    @if (!string.IsNullOrWhiteSpace(heroImageUrl))
    {
      <div class="lp-lp-hero__visual">
        <img src="@heroImageUrl" alt="@heading" class="lp-lp-hero__image" />
      </div>
    }

  </div>

  @if (logos != null && logos.Any())
  {
    <div class="lp-lp-logos">
      <div class="lp-lp-logos__lbl">Brukt av ledende norske bedrifter</div>
      <div class="lp-lp-logos__pills">
        @foreach (var logo in logos)
        {
          <span class="lp-lp-logo-pill">@logo</span>
        }
      </div>
    </div>
  }

</section>
