@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement>
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using System.Linq

@{
    var eyebrow     = Model.Value<string>("eyebrow")     ?? "Klar til å prøve?";
    var heading     = Model.Value<string>("heading")     ?? "Klar for en lunsjordning som faktisk fungerer?";
    var text        = Model.Value<string>("text")        ?? "Prøv Lunchportalen gratis i 5 dager. Ingen forpliktelser, ingen kredittkort.";
    var trustSignal = Model.Value<string>("trustSignal") ?? "5 dager gratis · Ingen kredittkort · Kom i gang på 15 min";

    var primaryCtaLinks = Model.Value<IEnumerable<Link>>("primaryCtaLink");
    var primaryCta      = primaryCtaLinks?.FirstOrDefault();
    var primaryCtaText  = Model.Value<string>("primaryCtaText") ?? "Prøv gratis i 5 dager";
    var primaryUrl      = AppUrls.ResolveLeadCapture(primaryCta?.Url, "losningen-primary");

    var secCtaLinks = Model.Value<IEnumerable<Link>>("secCtaLink");
    var secCta      = secCtaLinks?.FirstOrDefault();
    var secCtaText  = Model.Value<string>("secCtaText") ?? "Book demo";
    var secUrl      = AppUrls.ResolveLeadCapture(secCta?.Url, "losningen-book-demo");

    bool hasSecCta = !string.IsNullOrWhiteSpace(secCtaText);
}

<section class="ls-cta-band">
    <div class="ls-inner">
        <div class="ls-cta-band__card ls-reveal">

            <p class="ls-eyebrow ls-eyebrow--light">@eyebrow</p>
            <h2 class="ls-cta-band__heading">@heading</h2>
            <p class="ls-cta-band__text">@text</p>

            <div class="ls-cta-band__actions">
                <a href="@primaryUrl"
                   class="ls-cta-band__btn-primary"
                   @(primaryCta?.Target == "_blank" ? Html.Raw("target=\"_blank\" rel=\"noopener\"") : Html.Raw(""))>
                    @primaryCtaText
                    <span aria-hidden="true">→</span>
                </a>

                @if (hasSecCta)
                {
                    <a href="@secUrl"
                       class="ls-cta-band__btn-sec"
                       @(secCta?.Target == "_blank" ? Html.Raw("target=\"_blank\" rel=\"noopener\"") : Html.Raw(""))>
                        @secCtaText
                    </a>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(trustSignal))
            {
                <p class="ls-cta-band__trust">@trustSignal</p>
            }

        </div>
    </div>
</section>
