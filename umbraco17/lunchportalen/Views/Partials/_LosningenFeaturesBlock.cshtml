@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement>
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent

@{
    var eyebrow = Model.Value<string>("eyebrow") ?? "Funksjoner";
    var heading = Model.Value<string>("heading") ?? "Alt du trenger, ingenting du ikke trenger";

    var featureBlocks = Model.Value<BlockListModel>("features");

    var defaultFeatures = new[]
    {
        new { Tag = "For ansatte",   Title = "Bestill og avbestill på 10 sekunder",    Body = "Ansatte åpner appen, velger lunsj og trykker bestill. Avbestilling er mulig frem til kl. 08:00 samme dag – direkte fra mobilen, uten å kontakte noen.", ImageSide = "right", Checks = "Fungerer på iOS og Android\nVarsler om bestillingsfrist\nAvbestilling uten friksjon",   Mockup = 0 },
        new { Tag = "For bedriften", Title = "Full oversikt uten daglig oppfølging",   Body = "Dashbordet viser hvem som har bestilt, hva som leveres og hva dere faktisk betaler for. Alt oppdateres automatisk.",                                     ImageSide = "left",  Checks = "Sanntids bestillingsoversikt\nAutomatisk fakturering\nEksport til lønnssystem",       Mockup = 1 },
        new { Tag = "For kjøkkenet", Title = "Kjøkkenet lager nøyaktig nok",           Body = "Produksjonsgrunnlaget sendes automatisk til kjøkkenet basert på faktiske bestillinger. Slutt på gjetting, slutt på matsvinn.",                              ImageSide = "right", Checks = "Automatisk produksjonsliste\nReduserer matsvinn med 32%\nTilpasset leveringsavtale",  Mockup = 2 },
    };

    bool hasBlocks = featureBlocks != null && featureBlocks.Any();
}

<section class="ls-features">
    <div class="ls-inner">

        <div class="ls-reveal">
            <p class="ls-eyebrow">@eyebrow</p>
            <h2 class="ls-h2">@heading</h2>
        </div>

        @if (hasBlocks)
        {
            int fi = 0;
            foreach (var block in featureBlocks)
            {
                var tag       = block.Content.Value<string>("tag")       ?? "";
                var title     = block.Content.Value<string>("title")     ?? "";
                var body      = block.Content.Value<string>("body")      ?? "";
                var side      = block.Content.Value<string>("imageSide") ?? (fi % 2 == 0 ? "right" : "left");
                var img       = block.Content.Value<IPublishedContent>("image");
                var checksRaw = block.Content.Value<string>("checks")   ?? "";
                var checkItems = checksRaw.Split('\n').Select(s => s.Trim()).Where(s => !string.IsNullOrWhiteSpace(s)).ToList();

                <div class="ls-feature @(side == "left" ? "ls-feature--reverse" : "") ls-reveal">
                    <div class="ls-feature__text">
                        @if (!string.IsNullOrWhiteSpace(tag)) { <span class="ls-feature__tag">@tag</span> }
                        <h3 class="ls-feature__title">@title</h3>
                        <p class="ls-feature__body">@body</p>
                        @if (checkItems.Any())
                        {
                            <ul class="ls-feature__checks">
                                @foreach (var check in checkItems) { <li>@check</li> }
                            </ul>
                        }
                    </div>
                    <div class="ls-feature__media">
                        @if (img != null)
                        {
                            <img src="@img.Url()" alt="@title" loading="lazy" />
                        }
                        else if (fi == 0)
                        {
                            <div class="ls-mockup" aria-hidden="true">
                                <div class="ls-mockup__chrome">
                                    <div class="ls-mockup__dots"><span style="background:#FF5F57"></span><span style="background:#FEBC2E"></span><span style="background:#28C840"></span></div>
                                    <div class="ls-mockup__url">app.lunchportalen.no</div>
                                </div>
                                <div class="ls-mockup__body">
                                    <div class="ls-mockup__topbar"><span class="ls-mockup__label">Dagens lunsj</span><span class="ls-mockup__date">Onsdag 30. april</span></div>
                                    <div class="ls-mockup__deadline"><span>Bestillingsfrist</span><span class="ls-mockup__deadline-val">kl. 08:00 i dag</span></div>
                                    <div class="ls-mockup__section-label">Velg din lunsj</div>
                                    <div class="ls-mockup__item ls-mockup__item--selected">
                                        <div class="ls-mockup__item-left"><div class="ls-mockup__emoji">🥗</div><div><div class="ls-mockup__item-name">Salatbar</div><div class="ls-mockup__item-sub">Fersk salat med dagens tilbehør</div></div></div>
                                        <div class="ls-mockup__check">✓</div>
                                    </div>
                                    <div class="ls-mockup__item">
                                        <div class="ls-mockup__item-left"><div class="ls-mockup__emoji">🥪</div><div><div class="ls-mockup__item-name">Påsmurt</div><div class="ls-mockup__item-sub">Dagens brødskiver med pålegg</div></div></div>
                                        <div class="ls-mockup__check ls-mockup__check--empty"></div>
                                    </div>
                                    <div class="ls-mockup__item">
                                        <div class="ls-mockup__item-left"><div class="ls-mockup__emoji">🍲</div><div><div class="ls-mockup__item-name">Varmmat</div><div class="ls-mockup__item-sub">Dagens varme rett</div></div></div>
                                        <div class="ls-mockup__check ls-mockup__check--empty"></div>
                                    </div>
                                    <div class="ls-mockup__cta-row">
                                        <button class="ls-mockup__btn-primary" type="button">Bestill</button>
                                        <button class="ls-mockup__btn-ghost" type="button">Avbestill</button>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (fi == 1)
                        {
                            <div class="ls-mockup" aria-hidden="true">
                                <div class="ls-mockup__chrome">
                                    <div class="ls-mockup__dots"><span style="background:#FF5F57"></span><span style="background:#FEBC2E"></span><span style="background:#28C840"></span></div>
                                    <div class="ls-mockup__url">admin.lunchportalen.no</div>
                                </div>
                                <div class="ls-mockup__body">
                                    <div class="ls-mockup__topbar"><span class="ls-mockup__label">Oversikt</span><span class="ls-mockup__date">I dag</span></div>
                                    <div class="ls-mockup__stat-row">
                                        <div class="ls-mockup__stat"><div class="ls-mockup__stat-num">142</div><div class="ls-mockup__stat-lbl">Bestillinger</div></div>
                                        <div class="ls-mockup__stat"><div class="ls-mockup__stat-num">18</div><div class="ls-mockup__stat-lbl">Avbestilte</div></div>
                                        <div class="ls-mockup__stat"><div class="ls-mockup__stat-num ls-mockup__stat-num--gold">124</div><div class="ls-mockup__stat-lbl">Leveres</div></div>
                                    </div>
                                    <div class="ls-mockup__section-label">Ansatte i dag</div>
                                    <div class="ls-mockup__row-item"><div class="ls-mockup__avatar">KA</div><div class="ls-mockup__row-name">Kari Andersen</div><div class="ls-mockup__badge ls-mockup__badge--green">Bestilt</div></div>
                                    <div class="ls-mockup__row-item"><div class="ls-mockup__avatar">OB</div><div class="ls-mockup__row-name">Ole Berg</div><div class="ls-mockup__badge ls-mockup__badge--green">Bestilt</div></div>
                                    <div class="ls-mockup__row-item"><div class="ls-mockup__avatar">MH</div><div class="ls-mockup__row-name">Marie Holm</div><div class="ls-mockup__badge ls-mockup__badge--gray">Avbestilt</div></div>
                                    <div class="ls-mockup__row-item"><div class="ls-mockup__avatar">TN</div><div class="ls-mockup__row-name">Thomas Nygård</div><div class="ls-mockup__badge ls-mockup__badge--green">Bestilt</div></div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="ls-mockup" aria-hidden="true">
                                <div class="ls-mockup__chrome">
                                    <div class="ls-mockup__dots"><span style="background:#FF5F57"></span><span style="background:#FEBC2E"></span><span style="background:#28C840"></span></div>
                                    <div class="ls-mockup__url">app.lunchportalen.no/produksjon</div>
                                </div>
                                <div class="ls-mockup__body">
                                    <div class="ls-mockup__topbar"><span class="ls-mockup__label">Produksjonsliste</span><span class="ls-mockup__date">30. april</span></div>
                                    <div class="ls-mockup__section-label">Levering kl. 11:30</div>
                                    <div class="ls-mockup__kitchen-item"><div class="ls-mockup__kitchen-left"><div class="ls-mockup__emoji">🥗</div><span class="ls-mockup__kitchen-name">Salatbar</span></div><div class="ls-mockup__kitchen-count"><span class="ls-mockup__count-num">68</span><span class="ls-mockup__count-lbl">porsjoner</span></div></div>
                                    <div class="ls-mockup__kitchen-item"><div class="ls-mockup__kitchen-left"><div class="ls-mockup__emoji">🥪</div><span class="ls-mockup__kitchen-name">Påsmurt</span></div><div class="ls-mockup__kitchen-count"><span class="ls-mockup__count-num">31</span><span class="ls-mockup__count-lbl">porsjoner</span></div></div>
                                    <div class="ls-mockup__kitchen-item"><div class="ls-mockup__kitchen-left"><div class="ls-mockup__emoji">🍲</div><span class="ls-mockup__kitchen-name">Varmmat</span></div><div class="ls-mockup__kitchen-count"><span class="ls-mockup__count-num">25</span><span class="ls-mockup__count-lbl">porsjoner</span></div></div>
                                    <div class="ls-mockup__kitchen-footer">
                                        <div class="ls-mockup__kitchen-total"><span>Totalt</span><span class="ls-mockup__kitchen-total-num">124 porsjoner</span></div>
                                        <div class="ls-mockup__svinn-badge"><span>−32%</span><span>matsvinn vs. kantine</span></div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                fi++;
            }
        }
        else
        {
            int fi = 0;
            foreach (var feature in defaultFeatures)
            {
                var checkItems = feature.Checks.Split('\n').Select(s => s.Trim()).Where(s => !string.IsNullOrWhiteSpace(s)).ToList();

                <div class="ls-feature @(feature.ImageSide == "left" ? "ls-feature--reverse" : "") ls-reveal">
                    <div class="ls-feature__text">
                        <span class="ls-feature__tag">@feature.Tag</span>
                        <h3 class="ls-feature__title">@feature.Title</h3>
                        <p class="ls-feature__body">@feature.Body</p>
                        <ul class="ls-feature__checks">
                            @foreach (var check in checkItems) { <li>@check</li> }
                        </ul>
                    </div>
                    <div class="ls-feature__media">
                        @if (feature.Mockup == 0)
                        {
                            <div class="ls-mockup" aria-hidden="true">
                                <div class="ls-mockup__chrome">
                                    <div class="ls-mockup__dots"><span style="background:#FF5F57"></span><span style="background:#FEBC2E"></span><span style="background:#28C840"></span></div>
                                    <div class="ls-mockup__url">app.lunchportalen.no</div>
                                </div>
                                <div class="ls-mockup__body">
                                    <div class="ls-mockup__topbar"><span class="ls-mockup__label">Dagens lunsj</span><span class="ls-mockup__date">Onsdag 30. april</span></div>
                                    <div class="ls-mockup__deadline"><span>Bestillingsfrist</span><span class="ls-mockup__deadline-val">kl. 08:00 i dag</span></div>
                                    <div class="ls-mockup__section-label">Velg din lunsj</div>
                                    <div class="ls-mockup__item ls-mockup__item--selected">
                                        <div class="ls-mockup__item-left"><div class="ls-mockup__emoji">🥗</div><div><div class="ls-mockup__item-name">Salatbar</div><div class="ls-mockup__item-sub">Fersk salat med dagens tilbehør</div></div></div>
                                        <div class="ls-mockup__check">✓</div>
                                    </div>
                                    <div class="ls-mockup__item">
                                        <div class="ls-mockup__item-left"><div class="ls-mockup__emoji">🥪</div><div><div class="ls-mockup__item-name">Påsmurt</div><div class="ls-mockup__item-sub">Dagens brødskiver med pålegg</div></div></div>
                                        <div class="ls-mockup__check ls-mockup__check--empty"></div>
                                    </div>
                                    <div class="ls-mockup__item">
                                        <div class="ls-mockup__item-left"><div class="ls-mockup__emoji">🍲</div><div><div class="ls-mockup__item-name">Varmmat</div><div class="ls-mockup__item-sub">Dagens varme rett</div></div></div>
                                        <div class="ls-mockup__check ls-mockup__check--empty"></div>
                                    </div>
                                    <div class="ls-mockup__cta-row">
                                        <button class="ls-mockup__btn-primary" type="button">Bestill</button>
                                        <button class="ls-mockup__btn-ghost" type="button">Avbestill</button>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (feature.Mockup == 1)
                        {
                            <div class="ls-mockup" aria-hidden="true">
                                <div class="ls-mockup__chrome">
                                    <div class="ls-mockup__dots"><span style="background:#FF5F57"></span><span style="background:#FEBC2E"></span><span style="background:#28C840"></span></div>
                                    <div class="ls-mockup__url">admin.lunchportalen.no</div>
                                </div>
                                <div class="ls-mockup__body">
                                    <div class="ls-mockup__topbar"><span class="ls-mockup__label">Oversikt</span><span class="ls-mockup__date">I dag</span></div>
                                    <div class="ls-mockup__stat-row">
                                        <div class="ls-mockup__stat"><div class="ls-mockup__stat-num">142</div><div class="ls-mockup__stat-lbl">Bestillinger</div></div>
                                        <div class="ls-mockup__stat"><div class="ls-mockup__stat-num">18</div><div class="ls-mockup__stat-lbl">Avbestilte</div></div>
                                        <div class="ls-mockup__stat"><div class="ls-mockup__stat-num ls-mockup__stat-num--gold">124</div><div class="ls-mockup__stat-lbl">Leveres</div></div>
                                    </div>
                                    <div class="ls-mockup__section-label">Ansatte i dag</div>
                                    <div class="ls-mockup__row-item"><div class="ls-mockup__avatar">KA</div><div class="ls-mockup__row-name">Kari Andersen</div><div class="ls-mockup__badge ls-mockup__badge--green">Bestilt</div></div>
                                    <div class="ls-mockup__row-item"><div class="ls-mockup__avatar">OB</div><div class="ls-mockup__row-name">Ole Berg</div><div class="ls-mockup__badge ls-mockup__badge--green">Bestilt</div></div>
                                    <div class="ls-mockup__row-item"><div class="ls-mockup__avatar">MH</div><div class="ls-mockup__row-name">Marie Holm</div><div class="ls-mockup__badge ls-mockup__badge--gray">Avbestilt</div></div>
                                    <div class="ls-mockup__row-item"><div class="ls-mockup__avatar">TN</div><div class="ls-mockup__row-name">Thomas Nygård</div><div class="ls-mockup__badge ls-mockup__badge--green">Bestilt</div></div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="ls-mockup" aria-hidden="true">
                                <div class="ls-mockup__chrome">
                                    <div class="ls-mockup__dots"><span style="background:#FF5F57"></span><span style="background:#FEBC2E"></span><span style="background:#28C840"></span></div>
                                    <div class="ls-mockup__url">app.lunchportalen.no/produksjon</div>
                                </div>
                                <div class="ls-mockup__body">
                                    <div class="ls-mockup__topbar"><span class="ls-mockup__label">Produksjonsliste</span><span class="ls-mockup__date">30. april</span></div>
                                    <div class="ls-mockup__section-label">Levering kl. 11:30</div>
                                    <div class="ls-mockup__kitchen-item"><div class="ls-mockup__kitchen-left"><div class="ls-mockup__emoji">🥗</div><span class="ls-mockup__kitchen-name">Salatbar</span></div><div class="ls-mockup__kitchen-count"><span class="ls-mockup__count-num">68</span><span class="ls-mockup__count-lbl">porsjoner</span></div></div>
                                    <div class="ls-mockup__kitchen-item"><div class="ls-mockup__kitchen-left"><div class="ls-mockup__emoji">🥪</div><span class="ls-mockup__kitchen-name">Påsmurt</span></div><div class="ls-mockup__kitchen-count"><span class="ls-mockup__count-num">31</span><span class="ls-mockup__count-lbl">porsjoner</span></div></div>
                                    <div class="ls-mockup__kitchen-item"><div class="ls-mockup__kitchen-left"><div class="ls-mockup__emoji">🍲</div><span class="ls-mockup__kitchen-name">Varmmat</span></div><div class="ls-mockup__kitchen-count"><span class="ls-mockup__count-num">25</span><span class="ls-mockup__count-lbl">porsjoner</span></div></div>
                                    <div class="ls-mockup__kitchen-footer">
                                        <div class="ls-mockup__kitchen-total"><span>Totalt</span><span class="ls-mockup__kitchen-total-num">124 porsjoner</span></div>
                                        <div class="ls-mockup__svinn-badge"><span>−32%</span><span>matsvinn vs. kantine</span></div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                fi++;
            }
        }

    </div>
</section>
