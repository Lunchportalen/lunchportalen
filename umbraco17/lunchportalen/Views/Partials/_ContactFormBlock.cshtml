@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement>
@using Umbraco.Extensions

@{
    var heading = Model.Value<string>("heading") ?? "Send oss en forespørsel";
    var text = Model.Value<string>("text");
    var nameLabel = Model.Value<string>("nameLabel") ?? "Navn";
    var emailLabel = Model.Value<string>("emailLabel") ?? "E-post";
    var phoneLabel = Model.Value<string>("phoneLabel") ?? "Telefon";
    var companyLabel = Model.Value<string>("companyLabel") ?? "Bedrift";
    var orgNumberLabel = Model.Value<string>("orgNumberLabel") ?? "Organisasjonsnummer";
    var messageLabel = Model.Value<string>("messageLabel") ?? "Hva ønsker dere hjelp med?";
    var buttonLabel = Model.Value<string>("buttonLabel") ?? "Send forespørsel";

    var currentPath = Context.Request.Path.ToString().ToLowerInvariant();
    var isDemoPage = currentPath.Contains("/demo");

    var formSource = isDemoPage ? "demo" : "kontakt";
    var formAction = isDemoPage ? "/demo/" : "/kontakt/";
    var eyebrow = isDemoPage ? "Demo" : "Kontakt";
}

<section class="lp-contact-form-block" id="kontakt">
    <div class="lp-contact-form-block__inner">

        <div class="lp-contact-form-block__content">
            <p class="lp-contact-form-block__eyebrow">@eyebrow</p>
            <h2>@heading</h2>

            @if (!string.IsNullOrWhiteSpace(text))
            {
                <p>@text</p>
            }

            <div class="lp-contact-form-block__details">
                <a href="mailto:post@lunchportalen.no">post@lunchportalen.no</a>
                <a href="tel:+4748155481">481 55 481</a>
                <span>Trondheim · Norge</span>
            </div>
        </div>

        <form class="lp-contact-form" method="post" action="@formAction">
            <input type="hidden" name="source" value="@formSource" />

            <div class="lp-contact-form__grid">
                <label>
                    <span>@nameLabel</span>
                    <input type="text" name="name" autocomplete="name" required />
                </label>

                <label>
                    <span>@emailLabel</span>
                    <input type="email" name="email" autocomplete="email" required />
                </label>

                <label>
                    <span>@phoneLabel</span>
                    <input type="tel" name="phone" autocomplete="tel" />
                </label>

                <label>
                    <span>@companyLabel</span>
                    <input type="text" name="company" autocomplete="organization" />
                </label>

                <label>
                    <span>@orgNumberLabel</span>
                    <input type="text" name="orgNumber" inputmode="numeric" pattern="[0-9]{9}" placeholder="9 siffer" />
                </label>
            </div>

            <label class="lp-contact-form__message">
                <span>@messageLabel</span>
                <textarea name="message" rows="6" required></textarea>
            </label>

            <button type="submit">
                @buttonLabel
                <span aria-hidden="true">→</span>
            </button>
        </form>

    </div>
</section>


