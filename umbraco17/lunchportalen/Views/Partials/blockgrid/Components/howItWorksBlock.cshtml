@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>
@using System.Linq
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent

@functions {
    private static Link? FirstLink(object? value)
    {
        if (value is Link single) return single;
        if (value is IEnumerable<Link> many) return many.FirstOrDefault();
        return null;
    }

    private static string LinkTarget(Link? link) =>
        link?.Target == "_blank" ? "target=\"_blank\" rel=\"noopener noreferrer\"" : "";
}

@{
    var content = Model.Content;
    var eyebrow = content.Value<string>("eyebrow");
    var heading = content.Value<string>("heading");
    var items = content.Value<IEnumerable<BlockListItem>>("items");
}

<section class="ds-section" id="howitworks">
    <div class="ds-container">
        <div class="ds-text-limit ds-fade-up">
            @if (!string.IsNullOrWhiteSpace(eyebrow))
            {
                <p class="ds-eyebrow">@eyebrow</p>
            }
            @if (!string.IsNullOrWhiteSpace(heading))
            {
                <h2 class="ds-h2">@heading</h2>
            }
        </div>

        @if (items != null && items.Any())
        {
            var stepList = items.ToList();
            <ul class="ds-how-list">
                @for (var i = 0; i < stepList.Count; i++)
                {
                    var step = stepList[i].Content;
                    var stepNumber = step.Value<string>("stepNumber");
                    var title = step.Value<string>("title");
                    var body = step.Value<string>("body");
                    var media = step.Value<IPublishedContent>("media");
                    var cta = FirstLink(step.Value("cta"));
                    var rowClass = i % 2 == 1
                        ? "ds-how-row ds-how-row--reverse ds-fade-up"
                        : "ds-how-row ds-fade-up";

                    <li class="@rowClass">
                        <div class="ds-how-text">
                            @if (!string.IsNullOrWhiteSpace(stepNumber))
                            {
                                <div class="ds-step__number">@stepNumber</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(title))
                            {
                                <h3 class="ds-how-title">@title</h3>
                            }
                            @if (!string.IsNullOrWhiteSpace(body))
                            {
                                <p class="ds-how-body">@body</p>
                            }
                            @if (cta != null && !string.IsNullOrWhiteSpace(cta.Url))
                            {
                                <div class="ds-how-button">
                                    <a href="@cta.Url"
                                       class="ds-btn ds-btn--primary"
                                       @Html.Raw(LinkTarget(cta))>
                                        @(!string.IsNullOrWhiteSpace(cta.Name) ? cta.Name : cta.Url)
                                    </a>
                                </div>
                            }
                        </div>
                        @if (media != null)
                        {
                            <div class="ds-how-media">
                                <img src="@media.Url()" alt="@title" loading="lazy" />
                            </div>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</section>
