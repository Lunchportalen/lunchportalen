@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models.Blocks

@{
    var content = Model.Content;
    var heading = content.Value<string>("heading");
    var lead = content.Value<string>("lead");
    var items = content.Value<IEnumerable<BlockListItem>>("items");
}

<section class="fp-trust">
    <div class="fp-container fp-trust__inner">
        @if (!string.IsNullOrWhiteSpace(heading))
        {
            <h2 class="fp-trust__heading">@heading</h2>
        }
        @if (!string.IsNullOrWhiteSpace(lead))
        {
            <p class="fp-trust__lead">@lead</p>
        }

        @if (items != null && items.Any())
        {
            <ul class="fp-trust__list">
                @foreach (var item in items)
                {
                    var label = item.Content.Value<string>("label");
                    if (string.IsNullOrWhiteSpace(label))
                    {
                        continue;
                    }

                    <li class="fp-trust__item">
                        <span class="fp-trust__check" aria-hidden="true">✓</span>
                        <span>@label</span>
                    </li>
                }
            </ul>
        }
    </div>
</section>
