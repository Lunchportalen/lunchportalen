@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent

@{
    var content = Model.Content;
    var eyebrow = content.Value<string>("eyebrow");
    var heading = content.Value<string>("heading");
    var lead = content.Value<string>("lead");
    var items = content.Value<IEnumerable<BlockListItem>>("items");
    var headingLines = (heading ?? "")
        .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}

<section class="fp-feature fp-section">
    <div class="fp-container">
        <div class="fp-feature__header">
            @if (!string.IsNullOrWhiteSpace(eyebrow))
            {
                <div class="fp-eyebrow">
                    <span class="fp-eyebrow__dot" aria-hidden="true"></span>
                    <span>@eyebrow</span>
                </div>
            }
            @if (headingLines.Length > 0)
            {
                <h2 class="fp-heading fp-heading--center">
                    @foreach (var line in headingLines)
                    {
                        @line<br />
                    }
                </h2>
            }
            @if (!string.IsNullOrWhiteSpace(lead))
            {
                <p class="fp-lead fp-lead--center">@lead</p>
            }
        </div>

        @if (items != null && items.Any())
        {
            <div class="fp-feature__grid">
                @foreach (var item in items)
                {
                    var feature = item.Content;
                    var icon = feature.Value<IPublishedContent>("icon");
                    var featureTitle = feature.Value<string>("title");
                    var text = feature.Value<string>("text");

                    <article class="fp-feature-item">
                        @if (icon != null)
                        {
                            <div class="fp-feature-item__icon">
                                <img src="@icon.Url()" alt="" loading="lazy" />
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(featureTitle))
                        {
                            <h3 class="fp-feature-item__title">@featureTitle</h3>
                        }
                        @if (!string.IsNullOrWhiteSpace(text))
                        {
                            <p class="fp-feature-item__text">@text</p>
                        }
                    </article>
                }
            </div>
        }
    </div>
</section>
