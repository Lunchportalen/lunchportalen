@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>
@using System.Linq
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent

@functions {
    private static Link? FirstLink(object? value)
    {
        if (value is Link single) return single;
        if (value is IEnumerable<Link> many) return many.FirstOrDefault();
        return null;
    }

    private static string LinkTarget(Link? link) =>
        link?.Target == "_blank" ? "target=\"_blank\" rel=\"noopener noreferrer\"" : "";
}

@{
    var content = Model.Content;
    var eyebrow = content.Value<string>("eyebrow");
    var heading = content.Value<string>("heading");
    var lead = content.Value<string>("lead");
    var moreLink = FirstLink(content.Value("moreLink"));
    var items = content.Value<IEnumerable<BlockListItem>>("items");
}

<section class="ds-section ds-fade-up">
    <div class="ds-container">
        <div class="ds-text-limit">
            @if (!string.IsNullOrWhiteSpace(eyebrow))
            {
                <p class="ds-eyebrow">@eyebrow</p>
            }
            @if (!string.IsNullOrWhiteSpace(heading))
            {
                <h2 class="ds-h2">@heading</h2>
            }
            @if (!string.IsNullOrWhiteSpace(lead))
            {
                <p class="ds-lead">@lead</p>
            }
        </div>

        @if (items != null && items.Any())
        {
            <div class="ds-cards-3">
                @foreach (var item in items)
                {
                    var itemContent = item.Content;
                    var icon = itemContent.Value<IPublishedContent>("icon");
                    var itemTitle = itemContent.Value<string>("title");
                    var itemText = itemContent.Value<string>("text");

                    <article class="ds-card">
                        @if (icon != null)
                        {
                            <div class="ds-card__icon">
                                <img src="@icon.Url()" alt="" loading="lazy" />
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(itemTitle))
                        {
                            <h3 class="ds-card__title">@itemTitle</h3>
                        }
                        @if (!string.IsNullOrWhiteSpace(itemText))
                        {
                            <p class="ds-card__text">@itemText</p>
                        }
                    </article>
                }
            </div>
        }

        @if (moreLink != null && !string.IsNullOrWhiteSpace(moreLink.Url))
        {
            <div class="ds-section__actions">
                <a href="@moreLink.Url"
                   class="ds-btn ds-btn--primary"
                   @Html.Raw(LinkTarget(moreLink))>
                    @(!string.IsNullOrWhiteSpace(moreLink.Name) ? moreLink.Name : moreLink.Url)
                </a>
            </div>
        }
    </div>
</section>
