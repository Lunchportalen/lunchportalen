@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models.Blocks

@{
    var content = Model.Content;
    var eyebrow = content.Value<string>("eyebrow");
    var heading = content.Value<string>("heading");
    var items = content.Value<IEnumerable<BlockListItem>>("items");
}

<section class="fp-how fp-section" id="howitworks">
    <div class="fp-container">
        <div class="fp-how__header">
            @if (!string.IsNullOrWhiteSpace(eyebrow))
            {
                <div class="fp-eyebrow">
                    <span class="fp-eyebrow__dot" aria-hidden="true"></span>
                    <span>@eyebrow</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(heading))
            {
                <h2 class="fp-heading fp-heading--center">@heading</h2>
            }
        </div>

        @if (items != null && items.Any())
        {
            <ol class="fp-how__steps">
                @foreach (var item in items)
                {
                    var step = item.Content;
                    var stepNumber = step.Value<string>("stepNumber");
                    var icon = step.Value<string>("icon");
                    var title = step.Value<string>("title");
                    var body = step.Value<string>("body");

                    <li class="fp-step">
                        <div class="fp-step__top">
                            @if (!string.IsNullOrWhiteSpace(stepNumber))
                            {
                                <span class="fp-step__number">@stepNumber</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(icon))
                            {
                                <span class="fp-step__icon" aria-hidden="true">@icon</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(title))
                        {
                            <h3 class="fp-step__title">@title</h3>
                        }
                        @if (!string.IsNullOrWhiteSpace(body))
                        {
                            <p class="fp-step__body">@body</p>
                        }
                    </li>
                }
            </ol>
        }
    </div>
</section>
