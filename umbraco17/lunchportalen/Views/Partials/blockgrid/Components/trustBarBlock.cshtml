@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models.Blocks

@{
    var content = Model.Content;
    var heading = content.Value<string>("heading");
    var lead = content.Value<string>("lead");
    var items = content.Value<IEnumerable<BlockListItem>>("items");
}

<section class="ds-trust-bar ds-fade-up">
    <div class="ds-trust-bar__inner">
        @if (!string.IsNullOrWhiteSpace(heading))
        {
            <h2 class="ds-trust-bar__heading">@heading</h2>
        }
        @if (!string.IsNullOrWhiteSpace(lead))
        {
            <p class="ds-trust-bar__lead">@lead</p>
        }

        @if (items != null && items.Any())
        {
            <ul class="ds-trust-bar__list">
                @foreach (var item in items)
                {
                    var label = item.Content.Value<string>("label");
                    if (string.IsNullOrWhiteSpace(label))
                    {
                        continue;
                    }

                    <li class="ds-trust-bar__item">
                        <span class="ds-trust-bar__check" aria-hidden="true">✓</span>
                        <span class="ds-trust-bar__label">@label</span>
                    </li>
                }
            </ul>
        }
    </div>
</section>
