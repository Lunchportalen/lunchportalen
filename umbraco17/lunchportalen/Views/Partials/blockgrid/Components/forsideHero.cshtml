@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>
@using System.Linq
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent

@functions {
    private static Link? FirstLink(object? value)
    {
        if (value is Link single) return single;
        if (value is IEnumerable<Link> many) return many.FirstOrDefault();
        return null;
    }

    private static string LinkTarget(Link? link) =>
        link?.Target == "_blank" ? "target=\"_blank\" rel=\"noopener noreferrer\"" : "";
}

@{
    var content = Model.Content;
    var eyebrow = content.Value<string>("eyebrow");
    var title = content.Value<string>("title");
    var lead = content.Value<string>("lead");
    var heroMedia = content.Value<IPublishedContent>("heroMedia");
    var primaryCta = FirstLink(content.Value("primaryCta"));
    var secondaryCta = FirstLink(content.Value("secondaryCta"));
    var titleLines = (title ?? "")
        .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();
}

<section class="fp-hero">
    <div class="fp-container">
        <div class="fp-hero__inner">
            <div class="fp-hero__content">
                @if (!string.IsNullOrWhiteSpace(eyebrow))
                {
                    <div class="fp-eyebrow">
                        <span class="fp-eyebrow__dot" aria-hidden="true"></span>
                        <span>@eyebrow</span>
                    </div>
                }

                @if (titleLines.Count > 0)
                {
                    <h1 class="fp-hero__title">
                        @for (var i = 0; i < titleLines.Count; i++)
                        {
                            var lineClass = i == titleLines.Count - 1
                                ? "fp-hero__title-line fp-hero__title-line--accent"
                                : "fp-hero__title-line";
                            <span class="@lineClass">@titleLines[i]</span>
                        }
                    </h1>
                }

                @if (!string.IsNullOrWhiteSpace(lead))
                {
                    <p class="fp-hero__lead">@lead</p>
                }

                @if (primaryCta != null || secondaryCta != null)
                {
                    <div class="fp-hero__actions">
                        @if (primaryCta != null && !string.IsNullOrWhiteSpace(primaryCta.Url))
                        {
                            <a href="@primaryCta.Url"
                               class="fp-btn fp-btn--primary"
                               @Html.Raw(LinkTarget(primaryCta))>
                                @(!string.IsNullOrWhiteSpace(primaryCta.Name) ? primaryCta.Name : primaryCta.Url)
                                <span class="fp-btn__arrow" aria-hidden="true">→</span>
                            </a>
                        }
                        @if (secondaryCta != null && !string.IsNullOrWhiteSpace(secondaryCta.Url))
                        {
                            <a href="@secondaryCta.Url"
                               class="fp-btn fp-btn--ghost"
                               @Html.Raw(LinkTarget(secondaryCta))>
                                @(!string.IsNullOrWhiteSpace(secondaryCta.Name) ? secondaryCta.Name : secondaryCta.Url)
                            </a>
                        }
                    </div>
                }
            </div>

            @if (heroMedia != null)
            {
                <div class="fp-hero__visual">
                    <div class="fp-hero__media-wrap">
                        <div class="fp-hero__media">
                            <img src="@heroMedia.Url()"
                                 alt=""
                                 loading="eager"
                                 fetchpriority="high" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
