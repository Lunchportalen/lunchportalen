@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models.Blocks

@{
    var content = Model.Content;
    var label = content.Value<string>("label");
    var items = content.Value<IEnumerable<BlockListItem>>("items");
}

<section class="lp-social-proof ds-fade-up" aria-label="@label">
    <div class="lp-social-proof__inner">
        @if (!string.IsNullOrWhiteSpace(label))
        {
            <p class="lp-social-proof__label">@label</p>
        }

        @if (items != null && items.Any())
        {
            <div class="lp-social-proof__facts">
                @foreach (var item in items)
                {
                    var value = item.Content.Value<string>("value");
                    var itemLabel = item.Content.Value<string>("label");

                    if (string.IsNullOrWhiteSpace(value) && string.IsNullOrWhiteSpace(itemLabel))
                    {
                        continue;
                    }

                    <div class="lp-social-proof__fact">
                        @if (!string.IsNullOrWhiteSpace(value))
                        {
                            <strong>@value</strong>
                        }
                        @if (!string.IsNullOrWhiteSpace(itemLabel))
                        {
                            <span>@itemLabel</span>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>
