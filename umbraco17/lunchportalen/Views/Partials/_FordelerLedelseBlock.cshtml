@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement>
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models.PublishedContent

@{
    var eyebrow = Model.Value<string>("eyebrow") ?? "For ledelsen";
    var heading = Model.Value<string>("heading") ?? "Full kontroll – uten daglig oppfølging";
    var introText = Model.Value<string>("introText") ?? "Bedriften setter rammene én gang. Deretter håndteres bestilling og avbestilling automatisk av de ansatte – innenfor klare og trygge rammer.";
    var image = Model.Value<IPublishedContent>("image");
    var imageUrl = image?.Url();

    var benefits = new[]
    {
        new { Icon = "📊", Title = "Forutsigbar kostnad", Body = "Dere betaler kun for det som faktisk leveres – uten overraskelser." },
        new { Icon = "🚫", Title = "Null administrasjon", Body = "Ingen lister, avklaringer eller manuelle e-poster i hverdagen." },
        new { Icon = "👁️", Title = "Full oversikt", Body = "Se bestillinger, forbruk og leveringer på ett sted." },
        new { Icon = "📄", Title = "Automatisk fakturering", Body = "Fakturagrunnlag baseres på faktiske leveringer." },
        new { Icon = "🏗️", Title = "Ingen kantinedrift", Body = "Ingen eget kjøkken, bemanning eller daglig logistikk." },
        new { Icon = "⚡", Title = "Klar på få dager", Body = "Sett rammene én gang – og la systemet gjøre resten." }
    };
}

<section class="lp-benefits-section lp-benefits-section--leadership">
    <div class="lp-benefits-section__inner">

        <div class="lp-benefits-section__content">
            @if (!string.IsNullOrWhiteSpace(eyebrow))
            {
                <p class="lp-benefits-section__eyebrow">@eyebrow</p>
            }

            @if (!string.IsNullOrWhiteSpace(heading))
            {
                <h2 class="lp-benefits-section__heading">@heading</h2>
            }

            @if (!string.IsNullOrWhiteSpace(introText))
            {
                <p class="lp-benefits-section__text">@introText</p>
            }

            <div class="lp-benefits-grid">
                @foreach (var item in benefits)
                {
                    <article class="lp-benefits-card">
                        <div class="lp-benefits-card__icon">@item.Icon</div>
                        <div>
                            <h3 class="lp-benefits-card__title">@item.Title</h3>
                            <p class="lp-benefits-card__text">@item.Body</p>
                        </div>
                    </article>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(imageUrl))
        {
            <div class="lp-benefits-section__media">
                <img src="@imageUrl" alt="@heading" loading="lazy" />
            </div>
        }

    </div>