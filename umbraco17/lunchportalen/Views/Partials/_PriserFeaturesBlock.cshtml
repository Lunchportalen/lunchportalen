@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.PublishedContent.IPublishedElement>
@using System.Linq
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models.Blocks

@{
    var eyebrow = Model.Value<string>("eyebrow") ?? "Hva du faktisk får";
    var heading = Model.Value<string>("heading") ?? "Full kontroll på firmalunsj – uten administrasjon";
    var text    = Model.Value<string>("text")    ?? "Ansatte bestiller selv og avbestiller selv. Ledelsen slipper oppfølging, og dere betaler kun for det som faktisk blir levert.";
    var categories = Model.Value<BlockListModel>("featureCategories");
    var hasCategories = categories != null && categories.Any();
}

<section class="pr-features">
    <div class="pr-inner">

        <div class="pr-reveal">
            <p class="pr-eyebrow">@eyebrow</p>
            <h2 class="pr-h2">@heading</h2>
            <p class="pr-lead">@text</p>
        </div>

        @if (hasCategories)
        {
            <div class="pr-feature-table pr-reveal" style="--delay:100ms">

                <div class="pr-feature-table__head">
                    <div class="pr-feature-table__col-label"></div>
                    <div class="pr-feature-table__col pr-feature-table__col--plan">Basis</div>
                    <div class="pr-feature-table__col pr-feature-table__col--plan pr-feature-table__col--featured">Luxus</div>
                    <div class="pr-feature-table__col pr-feature-table__col--plan">Enterprise</div>
                </div>

                @foreach (var category in categories!)
                {
                    var categoryName = category.Content?.Value<string>("categoryName");
                    var rows = category.Content?.Value<BlockListModel>("rows");

                    if (string.IsNullOrWhiteSpace(categoryName) && (rows == null || !rows.Any()))
                    {
                        continue;
                    }

                    if (!string.IsNullOrWhiteSpace(categoryName))
                    {
                        <div class="pr-feature-table__category">@categoryName</div>
                    }

                    if (rows == null || !rows.Any())
                    {
                        continue;
                    }

                    @foreach (var rowBlock in rows)
                    {
                        var row = rowBlock.Content;
                        if (row == null) { continue; }

                        var label = row.Value<string>("label");
                        var basisIncluded = row.Value<bool>("basisIncluded");
                        var basisText = row.Value<string>("basisText");
                        var luxusIncluded = row.Value<bool>("luxusIncluded");
                        var luxusText = row.Value<string>("luxusText");
                        var enterpriseIncluded = row.Value<bool>("enterpriseIncluded");
                        var enterpriseText = row.Value<string>("enterpriseText");

                        if (string.IsNullOrWhiteSpace(label))
                        {
                            continue;
                        }

                        <div class="pr-feature__row">
                            <div class="pr-feature__label">@label</div>

                            <div class="pr-feature__cell">
                                @if (!string.IsNullOrWhiteSpace(basisText))
                                {
                                    <span class="pr-feature__text">@basisText</span>
                                }
                                else if (basisIncluded)
                                {
                                    <span class="pr-check" aria-label="Inkludert">✓</span>
                                }
                                else
                                {
                                    <span class="pr-dash" aria-label="Ikke inkludert">–</span>
                                }
                            </div>

                            <div class="pr-feature__cell pr-feature__cell--featured">
                                @if (!string.IsNullOrWhiteSpace(luxusText))
                                {
                                    <span class="pr-feature__text pr-feature__text--featured">@luxusText</span>
                                }
                                else if (luxusIncluded)
                                {
                                    <span class="pr-check" aria-label="Inkludert">✓</span>
                                }
                                else
                                {
                                    <span class="pr-dash" aria-label="Ikke inkludert">–</span>
                                }
                            </div>

                            <div class="pr-feature__cell">
                                @if (!string.IsNullOrWhiteSpace(enterpriseText))
                                {
                                    <span class="pr-feature__text">@enterpriseText</span>
                                }
                                else if (enterpriseIncluded)
                                {
                                    <span class="pr-check" aria-label="Inkludert">✓</span>
                                }
                                else
                                {
                                    <span class="pr-dash" aria-label="Ikke inkludert">–</span>
                                }
                            </div>
                        </div>
                    }
                }

            </div>
        }

    </div>
</section>
