@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Extensions

@{
    Layout = "~/Views/Partials/_Layout.cshtml";
}

@try {
  var grid = Model.Value<BlockGridModel>("forsideBlocks");
  if (grid?.Any() == true) {
    @await Html.GetBlockGridHtmlAsync(Model, "forsideBlocks")
  } else {
    @await Html.PartialAsync("~/Views/Partials/_ForsideDefaultComposition.cshtml")
  }
} catch {
  @await Html.PartialAsync("~/Views/Partials/_ForsideDefaultComposition.cshtml")
}
