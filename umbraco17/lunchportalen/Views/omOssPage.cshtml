@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Extensions

@{
    Layout = "~/Views/Partials/_Layout.cshtml";

    var blocks = Model.Value<BlockListModel>("contentBlocks");

    var metaTitle       = Model.Value<string>("metaTitle")
                          ?? "Om oss – Lunchportalen";
    var metaDescription = Model.Value<string>("metaDescription")
                          ?? "Lunchportalen er ikke en lunsjleverandør – vi er en ny måte å organisere firmalunsj på. Mindre svinn, null administrasjon og full kontroll for bedriften.";
    var canonicalUrl    = "https://www.lunchportalen.no/om-oss/";

    ViewData["MetaTitle"]       = metaTitle;
    ViewData["MetaDescription"] = metaDescription;
    ViewData["CanonicalUrl"]    = canonicalUrl;
    ViewData["BodyClass"]       = "page-om-oss";
}

@section Head {
    <link rel="stylesheet" href="/css/om-oss.css" />
}

@if (blocks != null && blocks.Any())
{
    @await Html.PartialAsync("~/Views/Partials/blocklist/default.cshtml", blocks)
}

@section Scripts {
<script>
(function () {
    'use strict';

    var supportsScrollTimeline = (function () {
        try { return CSS.supports('animation-timeline', 'view()'); } catch (e) { return false; }
    })();

    if (!supportsScrollTimeline) {
        var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
            });
        }, { threshold: 0.07, rootMargin: '0px 0px -48px 0px' });

        document.querySelectorAll('.oa-reveal').forEach(function (el) { io.observe(el); });

        document.querySelectorAll('.oa-reveal-group').forEach(function (group) {
            group.querySelectorAll(':scope > *').forEach(function (child, i) {
                child.style.setProperty('--i', i);
            });
            io.observe(group);
        });
    }
})();
</script>
}
